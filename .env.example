DB_HOST=localhost
DB_PORT=5432
DB_NAME=chuanga_studio
DB_USER=postgres
DB_PASSWORD=postgres

SERVER_PORT=8080

JWT_SECRET=troque-esta-chave-em-producao-troque-esta-chave-em-producao
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ADMIN_SEED_EMAIL=admin@chuangastudio.co.mz
ADMIN_SEED_PASSWORD=ChuangaAdmin123

# Email (Resend) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_REMETENTE=Chuanga Studio <onboarding@resend.dev>
EMAIL_RESPONDER_PARA=
# Email do estúdio que recebe os avisos de novas marcações e cotações
# Vários emails: separar por vírgula, ex. EMAIL_ESTUDIO=equipa@exemplo.com,gerente@exemplo.com
EMAIL_ESTUDIO=
# Pasta onde guardar o HTML de cada email (útil em desenvolvimento). Vazio = não guarda.
EMAIL_PASTA_PRE_VISUALIZACAO=

# Dados do estúdio usados nos emails
SITE_URL=https://chuanga-studio-front.vercel.app
ESTUDIO_TELEFONE=+258 84 658 9542
ESTUDIO_WHATSAPP=258846589542
ESTUDIO_LOCALIZACAO=Maputo – Moçambique

# Faturas
# URL pública da API (com /api), usada no link do PDF da fatura
API_URL=http://localhost:8080/api
# Mostrados na fatura (rodapé / "Como pagar"). Vazio = não aparece.
ESTUDIO_NUIT=
ESTUDIO_MPESA=
ESTUDIO_EMOLA=

# WhatsApp Business Cloud API (Meta) — envio automático da fatura em PDF.
# Vazio = não envia por WhatsApp (o painel continua a ter o botão manual).
# O template tem de estar aprovado: cabeçalho DOCUMENTO; corpo com {{1}} nome, {{2}} nº da fatura, {{3}} valor.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_FATURA=fatura_chuanga
WHATSAPP_TEMPLATE_IDIOMA=pt_PT

# Marcações (o horário de funcionamento e os dias fechados geres no painel → Horário)
ATENDIMENTOS_SIMULTANEOS=1
MARCACOES_INTERVALO_MINUTOS=30
MARCACOES_DIAS_ANTECEDENCIA=90

# Segurança
# Em produção (SPRING_PROFILES_ACTIVE=prod, já definido no Dockerfile) a app recusa arrancar com o
# JWT_SECRET ou o ADMIN_SEED_PASSWORD de exemplo. Gerar o segredo com: openssl rand -base64 48
LIMITE_PEDIDOS_ATIVO=true
# Recuperação de senha por código OTP de 6 dígitos: validade (min) e tentativas por código
RECUPERACAO_SENHA_MINUTOS=10
RECUPERACAO_SENHA_TENTATIVAS=5
# Palavras-passe erradas seguidas na mesma conta antes de um bloqueio temporário
LOGIN_MAX_FALHAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Erros 500 com exceção, mensagem e linha do código na resposta (true em dev; false por omissão em prod)
ERROS_DETALHADOS=true
# Swagger em /api/docs (em prod fica fechado, a menos que SWAGGER_ATIVO=true)
SWAGGER_ATIVO=false
# A cliente só remarca pela "Minha área" até X horas antes
MARCACOES_ANTECEDENCIA_REMARCAR_HORAS=24

# Lembretes por email (cliente, X horas antes) e agenda de amanhã para o estúdio às 18:00
LEMBRETES_ATIVO=true
LEMBRETES_HORAS_ANTES=24

# Relatórios de caixa por email ao estúdio (PDF em anexo)
# Semanal: sábado às 20:00 (últimos 7 dias). Fecho do dia: segunda a sexta às 20:00 (só se houve movimento).
RELATORIO_SEMANAL_ATIVO=true
RELATORIO_SEMANAL_CRON=0 0 20 * * SAT
RELATORIO_DIARIO_ATIVO=true
RELATORIO_DIARIO_CRON=0 0 20 * * MON-FRI
