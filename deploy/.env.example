# Copiar para .env (no servidor, ao lado do compose.yaml) e preencher.
# Nunca fazer commit do .env.

# Versão das imagens (latest = última da main; ou uma tag, ex.: 1.0.0)
TAG=latest
# Porta local onde o site fica à escuta (o proxy do servidor aponta para aqui)
WEB_PORT=8085

# ---- Base de dados ----
DB_NAME=chuanga_studio
DB_USER=chuanga
# openssl rand -base64 32
DB_PASSWORD=

# ---- Segurança ----
# openssl rand -base64 48
JWT_SECRET=
# Mesmo domínio do site: não há CORS entre o site e a API, mas fica definido
CORS_ORIGINS=https://chuanga-studio.com,https://www.chuanga-studio.com
# Conta admin criada no 1.º arranque (trocar a palavra-passe depois de entrar)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ---- URLs públicas ----
SITE_URL=https://chuanga-studio.com
API_URL=https://chuanga-studio.com/api

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_REMETENTE=Chuanga Studio <no-reply@chuanga-studio.com>
EMAIL_RESPONDER_PARA=
EMAIL_ESTUDIO=

# ---- Dados do estúdio ----
ESTUDIO_TELEFONE=+258 84 658 9542
ESTUDIO_WHATSAPP=258846589542
ESTUDIO_LOCALIZACAO=Maputo – Moçambique
ESTUDIO_NUIT=
ESTUDIO_MPESA=
ESTUDIO_EMOLA=

# ---- WhatsApp Business (opcional; vazio = desligado) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_FATURA=fatura_chuanga
WHATSAPP_TEMPLATE_IDIOMA=pt_PT

# Os restantes valores (limites, lembretes, relatórios...) têm valores por omissão;
# ver o .env.example na raiz do repositório para a lista completa.
